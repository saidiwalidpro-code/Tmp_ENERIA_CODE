package routines;

import java.util.regex.Matcher;
import java.util.regex.Pattern;

public class ZadigUtils {

    public static String extraireEventsOutlook(String message) {

        if (message == null || message.trim().isEmpty()) {
            return "";
        }

        StringBuilder resultat = new StringBuilder();

        Pattern pattern = Pattern.compile("(Add event|Delete event)\\s*\\([^\\)]*\\)");
        Matcher matcher = pattern.matcher(message);

        while (matcher.find()) {
            if (resultat.length() > 0) {
                resultat.append("\n");
            }

            resultat.append(matcher.group());
        }

        return resultat.toString();
    }

    public static String escapeHtml(String texte) {
        if (texte == null) {
            return "";
        }

        return texte
                .replace("&", "&amp;")
                .replace("<", "&lt;")
                .replace(">", "&gt;")
                .replace("\"", "&quot;");
    }
}