  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="280" posY="-920">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="context.timestamp= TalendDate.formatDate(&quot;yyyyMMddHHmmss&quot;, TalendDate.getCurrentDate());&#xA;globalMap.put(&quot;MAIL_WARNINGS&quot;, new java.util.ArrayList&lt;java.util.Map&lt;String, String>>());&#xA;globalMap.put(&quot;MAIL_ERRORS&quot;, new java.util.ArrayList&lt;java.util.Map&lt;String, String>>());&#xA;globalMap.put(&quot;JOB_HAS_ERROR&quot;, false);"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="initialisation"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>
  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="880" posY="280">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_2" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="java.util.List&lt;java.util.Map&lt;String, String>> warnings =&#xA;    (java.util.List&lt;java.util.Map&lt;String, String>>) globalMap.get(&quot;MAIL_WARNINGS&quot;);&#xA;&#xA;java.util.List&lt;java.util.Map&lt;String, String>> errors =&#xA;    (java.util.List&lt;java.util.Map&lt;String, String>>) globalMap.get(&quot;MAIL_ERRORS&quot;);&#xA;&#xA;// On considère le job en erreur si JOB_HAS_ERROR = true OU si la liste errors contient quelque chose&#xA;boolean hasError = Boolean.TRUE.equals(globalMap.get(&quot;JOB_HAS_ERROR&quot;))&#xA;    || (errors != null &amp;&amp; !errors.isEmpty());&#xA;&#xA;String currentJobName = jobName;&#xA;String status = hasError ? &quot;ERREUR&quot; : &quot;SUCCÈS&quot;;&#xA;String color = hasError ? &quot;#c00000&quot; : &quot;#2e7d32&quot;;&#xA;&#xA;String subject = &quot;[&quot; + status + &quot;] [&quot; + context.environnement + &quot;] Job Talend - &quot; + currentJobName;&#xA;&#xA;StringBuilder html = new StringBuilder();&#xA;&#xA;html.append(&quot;&lt;html>&lt;body style='font-family:Arial, sans-serif;'>&quot;);&#xA;&#xA;html.append(&quot;&lt;h2 style='color:&quot;)&#xA;    .append(color)&#xA;    .append(&quot;;'>Job Talend : &quot;)&#xA;    .append(jobName)&#xA;    .append(&quot; - &quot;)&#xA;    .append(status)&#xA;    .append(&quot;&lt;/h2>&quot;);&#xA;&#xA;html.append(&quot;&lt;p>&lt;b>Date d'exécution :&lt;/b> &quot;)&#xA;    .append(routines.TalendDate.formatDate(&quot;yyyy-MM-dd HH:mm:ss&quot;, new java.util.Date()))&#xA;    .append(&quot;&lt;/p>&quot;);&#xA;&#xA;html.append(&quot;&lt;p>&lt;b>Environnement :&lt;/b> &quot;)&#xA;    .append(context.environnement)&#xA;    .append(&quot;&lt;/p>&quot;);&#xA;&#xA;html.append(&quot;&lt;hr/>&quot;);&#xA;&#xA;&#xA;// =====================================================================&#xA;// Pattern pour récupérer uniquement Add event (...) / Delete event (...)&#xA;// =====================================================================&#xA;&#xA;java.util.regex.Pattern patternEventOutlook =&#xA;    java.util.regex.Pattern.compile(&quot;(Add event|Delete event)\\s*\\([^\\)]*\\)&quot;);&#xA;&#xA;&#xA;// =====================================================================&#xA;// Section 1 : Events Outlook détectés&#xA;// =====================================================================&#xA;&#xA;html.append(&quot;&lt;h3>Events Outlook détectés&lt;/h3>&quot;);&#xA;&#xA;html.append(&quot;&lt;table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;width:100%;'>&quot;);&#xA;html.append(&quot;&lt;tr style='background-color:#f2f2f2;'>&quot;);&#xA;html.append(&quot;&lt;th>Date&lt;/th>&lt;th>Composant&lt;/th>&lt;th>Message&lt;/th>&quot;);&#xA;html.append(&quot;&lt;/tr>&quot;);&#xA;&#xA;int nbEventsOutlook = 0;&#xA;&#xA;if (warnings != null &amp;&amp; !warnings.isEmpty()) {&#xA;&#xA;    for (java.util.Map&lt;String, String> w : warnings) {&#xA;&#xA;        String rawMsg = w.get(&quot;message&quot;);&#xA;        if (rawMsg == null) {&#xA;            rawMsg = &quot;&quot;;&#xA;        }&#xA;&#xA;        StringBuilder msgFiltreBuilder = new StringBuilder();&#xA;&#xA;        java.util.regex.Matcher matcher = patternEventOutlook.matcher(rawMsg);&#xA;&#xA;        while (matcher.find()) {&#xA;            if (msgFiltreBuilder.length() > 0) {&#xA;                msgFiltreBuilder.append(&quot;\n&quot;);&#xA;            }&#xA;&#xA;            msgFiltreBuilder.append(matcher.group());&#xA;        }&#xA;&#xA;        String msgFiltre = msgFiltreBuilder.toString();&#xA;&#xA;        // Si ce tWarn ne contient pas d'event Outlook, on ne l'affiche pas dans cette section&#xA;        if (msgFiltre == null || msgFiltre.trim().isEmpty()) {&#xA;            continue;&#xA;        }&#xA;&#xA;        nbEventsOutlook++;&#xA;&#xA;        String msgHtml = msgFiltre&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;)&#xA;            .replace(&quot;\r\n&quot;, &quot;\n&quot;)&#xA;            .replace(&quot;\r&quot;, &quot;\n&quot;)&#xA;            .replace(&quot;\n&quot;, &quot;&lt;br/>&quot;);&#xA;&#xA;        String dateWarning = w.get(&quot;date&quot;);&#xA;        if (dateWarning == null) {&#xA;            dateWarning = &quot;&quot;;&#xA;        }&#xA;&#xA;        dateWarning = dateWarning&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;        String originWarning = w.get(&quot;origin&quot;);&#xA;        if (originWarning == null) {&#xA;            originWarning = &quot;&quot;;&#xA;        }&#xA;&#xA;        originWarning = originWarning&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;        html.append(&quot;&lt;tr>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(dateWarning).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(originWarning).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(msgHtml).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;/tr>&quot;);&#xA;    }&#xA;}&#xA;&#xA;if (nbEventsOutlook == 0) {&#xA;    html.append(&quot;&lt;tr>&lt;td colspan='3'>Aucun Add event ou Delete event détecté.&lt;/td>&lt;/tr>&quot;);&#xA;}&#xA;&#xA;html.append(&quot;&lt;/table>&quot;);&#xA;&#xA;&#xA;// =====================================================================&#xA;// Section 2 : Messages tWarn classiques&#xA;// On garde les autres tWarn : connexion BDD, déconnexion, messages métiers, etc.&#xA;// On évite de remettre le gros message Outlook brut déjà filtré au-dessus.&#xA;// =====================================================================&#xA;&#xA;html.append(&quot;&lt;br/>&quot;);&#xA;html.append(&quot;&lt;h3>Messages tWarn&lt;/h3>&quot;);&#xA;&#xA;html.append(&quot;&lt;table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;width:100%;'>&quot;);&#xA;html.append(&quot;&lt;tr style='background-color:#f2f2f2;'>&quot;);&#xA;html.append(&quot;&lt;th>Date&lt;/th>&lt;th>Composant&lt;/th>&lt;th>Message&lt;/th>&quot;);&#xA;html.append(&quot;&lt;/tr>&quot;);&#xA;&#xA;int nbWarningsClassiques = 0;&#xA;&#xA;if (warnings != null &amp;&amp; !warnings.isEmpty()) {&#xA;&#xA;    for (java.util.Map&lt;String, String> w : warnings) {&#xA;&#xA;        String rawMsg = w.get(&quot;message&quot;);&#xA;        if (rawMsg == null) {&#xA;            rawMsg = &quot;&quot;;&#xA;        }&#xA;&#xA;        java.util.regex.Matcher matcher = patternEventOutlook.matcher(rawMsg);&#xA;        boolean contientEventOutlook = matcher.find();&#xA;&#xA;        // Si c'est le gros message Outlook qui contient Add/Delete event,&#xA;        // on ne le remet pas ici pour éviter de polluer le mail.&#xA;        if (contientEventOutlook) {&#xA;            continue;&#xA;        }&#xA;&#xA;        nbWarningsClassiques++;&#xA;&#xA;        String msgHtml = rawMsg&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;)&#xA;            .replace(&quot;\r\n&quot;, &quot;\n&quot;)&#xA;            .replace(&quot;\r&quot;, &quot;\n&quot;)&#xA;            .replace(&quot;\n&quot;, &quot;&lt;br/>&quot;);&#xA;&#xA;        String dateWarning = w.get(&quot;date&quot;);&#xA;        if (dateWarning == null) {&#xA;            dateWarning = &quot;&quot;;&#xA;        }&#xA;&#xA;        dateWarning = dateWarning&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;        String originWarning = w.get(&quot;origin&quot;);&#xA;        if (originWarning == null) {&#xA;            originWarning = &quot;&quot;;&#xA;        }&#xA;&#xA;        originWarning = originWarning&#xA;            .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;            .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;            .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;            .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;        html.append(&quot;&lt;tr>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(dateWarning).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(originWarning).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;td>&quot;).append(msgHtml).append(&quot;&lt;/td>&quot;);&#xA;        html.append(&quot;&lt;/tr>&quot;);&#xA;    }&#xA;}&#xA;&#xA;if (nbWarningsClassiques == 0) {&#xA;    html.append(&quot;&lt;tr>&lt;td colspan='3'>Aucun autre tWarn détecté.&lt;/td>&lt;/tr>&quot;);&#xA;}&#xA;&#xA;html.append(&quot;&lt;/table>&quot;);&#xA;&#xA;&#xA;// =====================================================================&#xA;// Section 3 : Erreurs / tDie uniquement si erreur&#xA;// =====================================================================&#xA;&#xA;if (hasError) {&#xA;&#xA;    html.append(&quot;&lt;br/>&quot;);&#xA;    html.append(&quot;&lt;h3 style='color:#c00000;'>Erreur / tDie détecté&lt;/h3>&quot;);&#xA;&#xA;    html.append(&quot;&lt;table border='1' cellspacing='0' cellpadding='6' style='border-collapse:collapse;width:100%;'>&quot;);&#xA;    html.append(&quot;&lt;tr style='background-color:#c00000;color:white;'>&quot;);&#xA;    html.append(&quot;&lt;th>Date&lt;/th>&lt;th>Type&lt;/th>&lt;th>Composant&lt;/th>&lt;th>Code&lt;/th>&lt;th>Message&lt;/th>&quot;);&#xA;    html.append(&quot;&lt;/tr>&quot;);&#xA;&#xA;    if (errors == null || errors.isEmpty()) {&#xA;&#xA;        html.append(&quot;&lt;tr>&lt;td colspan='5'>Erreur détectée mais aucun détail récupéré par tLogCatcher.&lt;/td>&lt;/tr>&quot;);&#xA;&#xA;    } else {&#xA;&#xA;        for (java.util.Map&lt;String, String> e : errors) {&#xA;&#xA;            String errorDate = e.get(&quot;date&quot;);&#xA;            if (errorDate == null) {&#xA;                errorDate = &quot;&quot;;&#xA;            }&#xA;&#xA;            errorDate = errorDate&#xA;                .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;                .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;                .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;                .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;            String errorType = e.get(&quot;type&quot;);&#xA;            if (errorType == null) {&#xA;                errorType = &quot;&quot;;&#xA;            }&#xA;&#xA;            errorType = errorType&#xA;                .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;                .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;                .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;                .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;            String errorOrigin = e.get(&quot;origin&quot;);&#xA;            if (errorOrigin == null) {&#xA;                errorOrigin = &quot;&quot;;&#xA;            }&#xA;&#xA;            errorOrigin = errorOrigin&#xA;                .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;                .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;                .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;                .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;            String errorCode = e.get(&quot;code&quot;);&#xA;            if (errorCode == null) {&#xA;                errorCode = &quot;&quot;;&#xA;            }&#xA;&#xA;            errorCode = errorCode&#xA;                .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;                .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;                .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;                .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;);&#xA;&#xA;            String errorMsg = e.get(&quot;message&quot;);&#xA;            if (errorMsg == null) {&#xA;                errorMsg = &quot;&quot;;&#xA;            }&#xA;&#xA;            errorMsg = errorMsg&#xA;                .replace(&quot;&amp;&quot;, &quot;&amp;amp;&quot;)&#xA;                .replace(&quot;&lt;&quot;, &quot;&amp;lt;&quot;)&#xA;                .replace(&quot;>&quot;, &quot;&amp;gt;&quot;)&#xA;                .replace(&quot;\&quot;&quot;, &quot;&amp;quot;&quot;)&#xA;                .replace(&quot;\r\n&quot;, &quot;\n&quot;)&#xA;                .replace(&quot;\r&quot;, &quot;\n&quot;)&#xA;                .replace(&quot;\n&quot;, &quot;&lt;br/>&quot;);&#xA;&#xA;            html.append(&quot;&lt;tr>&quot;);&#xA;            html.append(&quot;&lt;td>&quot;).append(errorDate).append(&quot;&lt;/td>&quot;);&#xA;            html.append(&quot;&lt;td>&quot;).append(errorType).append(&quot;&lt;/td>&quot;);&#xA;            html.append(&quot;&lt;td>&quot;).append(errorOrigin).append(&quot;&lt;/td>&quot;);&#xA;            html.append(&quot;&lt;td>&quot;).append(errorCode).append(&quot;&lt;/td>&quot;);&#xA;            html.append(&quot;&lt;td>&quot;).append(errorMsg).append(&quot;&lt;/td>&quot;);&#xA;            html.append(&quot;&lt;/tr>&quot;);&#xA;        }&#xA;    }&#xA;&#xA;    html.append(&quot;&lt;/table>&quot;);&#xA;}&#xA;&#xA;html.append(&quot;&lt;/body>&lt;/html>&quot;);&#xA;&#xA;globalMap.put(&quot;MAIL_SUBJECT&quot;, subject);&#xA;globalMap.put(&quot;MAIL_BODY&quot;, html.toString());"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="LABEL" value="Construire le mail"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_2"/>
  </node>
