  <note opaque="true" posX="-40" posY="0" sizeHeight="201" sizeWidth="1361" text="Fermeture de la onnexion a la base de données &#xD;&#xA;SAVOIR">
    <elementParameter field="COLOR" name="NOTE_COLOR" value="166;193;152"/>
