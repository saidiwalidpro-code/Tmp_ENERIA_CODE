    <nodeData xsi:type="TalendMapper:MapperData">
      <uiProperties shellMaximized="true"/>
      <varTables sizeState="INTERMEDIATE" name="Var" minimized="true"/>
      <outputTables sizeState="INTERMEDIATE" name="out1" expressionFilter="row_Main.CORI != null&#xD;&#xA;&amp;&amp; row_Main.CORI.startsWith(&quot;B&quot;)&#xD;&#xA;&amp;&amp; row_Main.NCPT != null&#xD;&#xA;&amp;&amp; row_Main.NCPT.startsWith(&quot;512&quot;)" activateExpressionFilter="true">
        <mapperTableEntries name="encsoc" expression="row_Main.CSTE.substring(1,3)" type="id_String"/>
        <mapperTableEntries name="entypc" expression="&quot;0&quot;" type="id_String"/>
        <mapperTableEntries name="enncpt" expression="row_Main.NCPT" type="id_String"/>
        <mapperTableEntries name="ennenc" expression="row_Main.DNOR == null || row_Main.DNOR.trim().isEmpty()&#xD;&#xA;    ? null&#xD;&#xA;    : Integer.parseInt(row_Main.DNOR.trim())" type="id_Integer"/>
        <mapperTableEntries name="ennpie" expression="Integer.parseInt(String.valueOf(row_Main.NPIE)) " type="id_Integer"/>
