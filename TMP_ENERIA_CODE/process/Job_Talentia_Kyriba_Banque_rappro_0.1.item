    <elementParameter field="MEMO_SQL" name="QUERY" value="&quot;SELECT &quot; +&#xD;&#xA;&quot;CORI, &quot; +&#xD;&#xA;&quot;TRIM(NCPT), &quot; +&#xD;&#xA;&quot;CSTE, &quot; +&#xD;&#xA;&quot;TRIM(CHAR(CAST(DNOR AS DECIMAL(8,0)))) AS DNOR , &quot; +&#xD;&#xA;&quot;NPIE, &quot; +&#xD;&#xA;&quot;TRIM(CHAR(CAST(DTCT AS DECIMAL(8,0)))) AS DTCT, &quot; +&#xD;&#xA;&quot;TRIM(CHAR(CAST(DTVL AS DECIMAL(8,0)))) AS DTVL, &quot; +&#xD;&#xA;&quot;TRIM(CHAR(CAST(DTPC AS DECIMAL(8,0)))) AS DTPC, &quot; +&#xD;&#xA;&quot;CRAP, &quot; +&#xD;&#xA;&quot;MREG, &quot; +&#xD;&#xA;&quot;LECR, &quot; +&#xD;&#xA;&quot;SENS, &quot; +&#xD;&#xA;&quot;MON1, &quot; +&#xD;&#xA;&quot;MTDV, &quot; +&#xD;&#xA;&quot;CDEV &quot; +&#xD;&#xA;&quot;FROM &quot; + context.connection_TALENTIA_DB_Database + &quot;.ZZGEC&#xD;&#xA;WHERE DTCT BETWEEN 20261001 AND 20261030&quot;"/>
